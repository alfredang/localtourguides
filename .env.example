# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Google Sign-In (optional) ---
# Create an OAuth 2.0 Client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials
#
# Authorised JavaScript origins:
#   http://localhost:5173                          (dev)
#   https://localtourguides.tertiaryinfotech.com   (production)
#
# The SAME client id goes in both variables below: the server uses it to check
# the token audience, the client uses it to render the Google button. Leave
# both unset and the app simply hides the Google button (password login works).
#
# When the iOS app is added, append its client id to the server variable as a
# comma-separated list — the server accepts any audience in the list.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Core ---
# JWT_SECRET=change-me-in-production
# DATABASE_URL=postgres://user:pass@host:5432/localtourguides
# PORT=4000
